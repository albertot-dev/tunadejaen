---
import AboutUs from "@/components/AboutUs.astro";
import Citas from "@/components/Citas.astro";
import Contacto from "@/components/Contacto.astro";
import Info from "@/components/Info.astro";
import Intro from "@/components/Intro.astro";
import Marquee from "@/components/Marquee.astro";
import Numeros from "@/components/Numeros.astro";
import Servicios from "@/components/Servicios.astro";
import Timeline from "@/components/Timeline.astro";
import Header from "../components/Header.astro";
import Layout from "../layouts/Layout.astro";
---

<Layout title="Tuna de Jaén · Tuna Universitaria de Distrito de Jaén">
  <Intro />
  <Header />
  <Marquee
    items={["Bodas", "Serenatas", "Rondas", "Certámenes", "Viajes", "Desde 1983"]}
  />
  <main>
    <Info />
    <Numeros />
    <Timeline />
    <Citas />
    <AboutUs />
    <Servicios />
    <Marquee items={["Tuna de Jaén", "La muy ilustre e andariega"]} variant="outline" reverse />
    <Contacto />
  </main>
</Layout>
