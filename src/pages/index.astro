---
import Bloques from "@/components/Bloques.astro";
import Header from "@/components/Header.astro";
import Intro from "@/components/Intro.astro";
import Layout from "@/layouts/Layout.astro";
import { getInicio } from "@/lib/strapi";

const inicio = await getInicio();
---

<Layout title={inicio?.seo?.metaTitulo} description={inicio?.seo?.metaDescripcion}>
  <Intro />
  {inicio?.portada && <Header portada={inicio.portada} />}
  <main>
    <Bloques bloques={inicio?.bloques ?? []} />
  </main>
</Layout>
