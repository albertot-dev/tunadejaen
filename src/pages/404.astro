---
import Layout from "@/layouts/Layout.astro";
---

<Layout title="Página no encontrada · Tuna de Jaén">
  <main class="relative isolate flex min-h-[80svh] items-center overflow-hidden bg-ink text-white">
    <img
      src="/escudo-tuna-blanco.png"
      alt=""
      class="pointer-events-none absolute left-1/2 top-1/2 -z-10 w-[40rem] max-w-none -translate-x-1/2 -translate-y-1/2 opacity-[0.05]"
    />
    <div class="mx-auto max-w-3xl px-4 pt-32 text-center">
      <p class="text-outline font-display text-[8rem] font-bold leading-none text-primary-400 sm:text-[12rem]">404</p>
      <h1 class="mt-4 font-display text-4xl font-bold lg:text-5xl">Esta canción no está en el repertorio</h1>
      <p class="mt-4 text-lg text-white/70">
        La página que buscas no existe o se ha ido de ronda.
      </p>
      <a
        href="/"
        class="mt-10 inline-block rounded-full bg-primary-600 px-7 py-3.5 font-semibold transition hover:bg-primary-500"
      >
        Volver al inicio
      </a>
    </div>
  </main>
</Layout>
