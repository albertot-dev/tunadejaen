---
import { Image } from "astro:assets";
import headerImage from "@/assets/header-3.jpg";
import { contactos, email, formatPhone } from "@/data/contacto";
---

<div id="en-construccion" class="relative isolate min-h-[100svh] flex-col overflow-hidden bg-ink text-white">
  <Image
    src={headerImage}
    alt=""
    class="construccion-foto absolute inset-0 -z-20 h-full w-full object-cover opacity-30 blur-[2px]"
    widths={[800, 1400]}
    sizes="100vw"
  />
  <div class="absolute inset-0 -z-10 bg-gradient-to-b from-ink/70 via-ink/80 to-ink"></div>

  <main class="mx-auto flex w-full max-w-5xl grow flex-col items-center justify-center px-4 pb-10 pt-16 text-center">
    <img
      src="/escudo-tuna-blanco.png"
      alt="Escudo de la Tuna Universitaria de Distrito de Jaén"
      class="construccion-in h-28 w-28 object-contain sm:h-32 sm:w-32"
      style="--i: 0"
    />
    <p class="construccion-in mt-8 font-display text-lg italic text-primary-400 sm:text-xl" style="--i: 1">
      la muy ilustre e andariega Tuna de Jaén
    </p>
    <h1
      class="construccion-in mt-4 text-balance font-display text-4xl font-bold leading-tight sm:text-6xl lg:text-7xl"
      style="--i: 2"
    >
      Estamos terminando de afinar los últimos detalles<span class="text-primary-400">…</span>
    </h1>
    <p class="construccion-in mt-6 max-w-xl text-lg text-white/75" style="--i: 3">
      Muy pronto estrenamos web. Mientras tanto, si quieres contar con la Tuna,
      escríbenos o llámanos.
    </p>

    <ul class="construccion-in mt-10 grid w-full max-w-3xl gap-3 sm:grid-cols-3" style="--i: 4">
      {
        contactos.map((contacto) => (
          <li class="rounded-2xl border border-white/10 bg-white/5 p-5 backdrop-blur">
            <p class="font-semibold">{contacto.name}</p>
            <p class="mt-1 tabular-nums text-white/70">{formatPhone(contacto.phone)}</p>
            <div class="mt-4 flex justify-center gap-2">
              <a
                href={`https://wa.me/34${contacto.phone}`}
                target="_blank"
                rel="noopener"
                class="rounded-full bg-primary-600 px-4 py-2 text-sm font-semibold transition hover:bg-primary-500"
              >
                WhatsApp
              </a>
              <a
                href={`tel:${contacto.phone}`}
                class="rounded-full border border-white/30 px-4 py-2 text-sm font-semibold transition hover:bg-white/10"
              >
                Llamar
              </a>
            </div>
          </li>
        ))
      }
    </ul>

    <a
      href={`mailto:${email}`}
      class="construccion-in mt-8 font-display text-xl underline decoration-white/30 underline-offset-8 transition hover:decoration-primary-400 sm:text-2xl"
      style="--i: 5"
    >
      {email}
    </a>
  </main>

  <img
    src="/silueta-lunes-santo.png"
    alt=""
    class="pointer-events-none mx-auto block w-full max-w-xl opacity-15 invert"
  />
</div>

<style>
  .construccion-in {
    animation: construccion-in 1s cubic-bezier(0.16, 1, 0.3, 1) both;
    animation-delay: calc(var(--i) * 0.12s);
  }
  .construccion-foto {
    animation: construccion-zoom 20s ease-out both;
  }
  @keyframes construccion-in {
    from {
      opacity: 0;
      transform: translateY(24px);
    }
  }
  @keyframes construccion-zoom {
    from {
      transform: scale(1.15);
    }
  }
</style>
