---
import { fundacion, palmares } from "@/data/palmares";

const numbersPalmares = [
  { label: "Años de historia", amount: new Date().getFullYear() - fundacion },
  ...palmares.map((cifra) => ({ label: cifra.etiqueta, amount: cifra.cantidad })),
];
---

<section id="palmares" class="relative isolate overflow-hidden bg-primary-800 text-white">
  <img
    src="/escudo-tuna-blanco.png"
    alt=""
    class="pointer-events-none absolute -right-32 top-1/2 -z-10 w-[36rem] max-w-none -translate-y-1/2 opacity-[0.06] lg:-right-20 lg:w-[48rem]"
    data-parallax="0.15"
    loading="lazy"
  />
  <div
    class="absolute inset-0 -z-10 bg-[radial-gradient(ellipse_at_top_left,rgba(47,216,147,0.25),transparent_55%)]"
  >
  </div>

  <div class="mx-auto max-w-7xl px-4 py-24 lg:px-8 lg:py-32">
    <div class="max-w-3xl" data-reveal>
      <span class="text-sm font-semibold uppercase tracking-[0.25em] text-primary-300"
        >Palmarés</span
      >
      <h2 class="mt-3 text-balance font-display text-4xl font-bold leading-tight lg:text-6xl">
        Nuestra experiencia está avalada por nuestro palmarés
      </h2>
    </div>

    <dl class="mt-16 grid grid-cols-2 gap-px overflow-hidden rounded-3xl bg-white/10 lg:grid-cols-4">
      {
        numbersPalmares.map((palmares, index) => (
          <div
            class="group flex flex-col justify-between gap-6 bg-primary-800 p-6 transition-colors duration-500 hover:bg-primary-700 sm:p-8"
            data-reveal
            style={`--delay: ${index * 120}ms`}
          >
            <dt class="order-2 text-xs uppercase tracking-widest text-white/70 sm:text-sm">
              {palmares.label}
            </dt>
            <dd
              class="order-1 font-display text-6xl font-bold tabular-nums tracking-tighter text-white [text-shadow:0_0_30px_rgba(106,235,179,0.45)] sm:text-7xl lg:text-8xl"
              data-count={palmares.amount}
            >
              {palmares.amount}
            </dd>
          </div>
        ))
      }
    </dl>
  </div>
</section>
