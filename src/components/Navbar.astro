---
import HamburgerButton from "./HamburgerButton.astro";
//class="fixed top-0 left-0 w-[calc(100%-160px)] z-10 flex mt-5 mx-20 justify-center"
---

<header
  id="header-container"
  class="h-auto py-0 px-0 lg:p-10 z-20 fixed w-full flex justify-center top-0 font-light"
>
  <nav
    class="hidden lg:flex justify-between text-nowrap w-[calc(100%-160px)] bg-black/50 backdrop-blur-sm h-[90px] rounded-full px-4 py-2"
  >
    <div class="flex items-center justify-between gap-4 w-full text-white">
      <div class="flex">
        <a href="/" aria-label="Link a la home de la web del congreso">
          <img
            class="object-fill w-12"
            src="/escudo-tuna-blanco.png"
            alt="Escudo de la Tuna de Jaén"
          />
        </a>
      </div>
      <div class="flex w-full gap-3">
        <ul
          class="flex justify-end w-full items-center gap-3 leading-5 uppercase"
        >
          <li class="relative hover:text-green-700 transition-all duration-500">
            <a class="p-3" href="/nosotros">palmarés</a>
          </li>
          <li class="relative hover:text-green-700 transition-all duration-500">
            <a class="p-3" href="/nosotros">nosotros</a>
          </li>
          <li class="relative hover:text-green-700 transition-all duration-500">
            <a class="p-3" href="/nosotros">noticias</a>
          </li>
          <li
            class="relative border border-transparent hover:border-white hover:font-bold px-6 py-5 bg-green-700 text-white rounded-full hover:text-green-700 hover:bg-black transition-all duration-500"
          >
            <a class="p-3" href="/nosotros">Lunes Santo</a>
          </li>
        </ul>
      </div>
    </div>
  </nav>
  <nav
    class="lg:hidden flex justify-between items-center w-full rounded-md py-4 px-4 lg:p-10 m-4"
    id="menu-responsive"
  >
    <div class="flex flex-col items-start grow ml-4"></div>
    <div class="flex justify-between items-center gap-6">
      <div class="bg-black/50 p-4 backdrop-blur-sm rounded-md">
        <HamburgerButton class:list={"block lg:hidden"} id="menuButton" />
      </div>
      <div
        id="menuMobileContent"
        class="fixed
        inset-0
        z-[888]
        flex
        w-screen
        flex-col
        items-center
        overflow-x-auto
        
        lg:hidden"
      >
        <div class="bg-black absolute w-screen h-screen opacity-90"></div>
        <div
          class="flex justify-between items-center w-full py-8 px-14 lg:p-10 text-white z-[888]"
        >
          <img
            class="object-fill w-12"
            src="/escudo-tuna-blanco.png"
            alt="Logo de Hack-én"
          />
          <HamburgerButton id="innerMenuButton" />
        </div>
        <div
          id="links-list"
          class:list={[
            "flex flex-col items-center gap-5 text-2xl mt-12 mb-12 z-[888] text-white uppercase",
          ]}
        >
          <a
            class="hover:text-accent transition duration-300"
            href="#localizacion">palmarés</a
          >
          <a class="hover:text-accent transition duration-300" href="/nosotros"
            >nosotros</a
          >
          <a class="hover:text-accent transition duration-300" href="#"
            >noticias</a
          >

          <a class="hover:text-accent transition duration-300" href="/nosotros"
            >lunes santo</a
          >
        </div>
        <div class="flex items-center z-30">
          <a
            href="#"
            class="bg-primary py-4 px-10 rounded-md text-lg uppercase font-semibold hover:scale-110 transition-all duration-500"
          >
            ENTRADAS
          </a>
        </div>
        <hr class="h-[1px] w-1/2 border-t-0 mb-12" style="background:white" />
      </div>
    </div>
  </nav>
</header>

<style>
  #menuMobileContent {
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.3s;
    scrollbar-gutter: stable;
  }

  #menuMobileContent.open {
    opacity: 1 !important;
    pointer-events: all;
  }
</style>
<script>
  import { $ } from "@/lib/dom-selector";
  function toggleMenu(menuMobileContent: HTMLElement | null) {
    menuMobileContent?.classList.toggle("open");
    innerMenuButton?.classList.toggle("open");
    menuResponsive?.classList.toggle("backdrop-blur-xs");

    menuButton?.classList.toggle("open");
    document.body.classList.toggle("overflow-hidden");
    document.body.classList.toggle("lg:overflow-auto");
  }

  const menuResponsive = $("#menu-responsive");
  const linksList = $("#links-list");
  const menuButton = $("#menuButton");
  const innerMenuButton = $("#innerMenuButton");
  const menuMobileContext = $("#menuMobileContent");

  linksList?.children &&
    Array.from(linksList.children).forEach((child) => {
      child.addEventListener("click", () => {
        toggleMenu(menuMobileContext);
      });
    });

  menuButton?.addEventListener("hamburgerButtonClicked", () =>
    toggleMenu(menuMobileContext)
  );
  innerMenuButton?.addEventListener("hamburgerButtonClicked", () =>
    toggleMenu(menuMobileContext)
  );

  if (menuMobileContext?.classList.contains("open")) {
    toggleMenu(menuMobileContext);
  }
</script>
