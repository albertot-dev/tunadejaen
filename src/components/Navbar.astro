---
const links = [
  { href: "/historia", label: "Historia" },
  { href: "/lunes-santo", label: "Lunes Santo" },
  { href: "/aguinaldo", label: "Aguinaldo" },
  { href: "/archivo", label: "Archivo" },
  { href: "/agenda", label: "Agenda" },
  { href: "/ensayos", label: "Únete" },
];

const currentPath = Astro.url.pathname.replace(/\/$/, "");
const isCurrent = (href: string) =>
  currentPath === href || currentPath.startsWith(`${href}/`);
---

<header
  id="site-header"
  class="fixed inset-x-0 top-0 z-50 transition-all duration-500"
>
  <nav
    class="mx-auto flex max-w-7xl items-center justify-between px-4 py-4 text-white lg:px-8"
    aria-label="Principal"
  >
    <a href="/" class="flex items-center gap-3" aria-label="Inicio">
      <img
        src="/escudo-tuna-blanco.png"
        alt="Escudo de la Tuna de Jaén"
        class="h-12 w-12 object-contain"
      />
      <span class="hidden font-display text-lg leading-tight sm:block lg:hidden xl:block">
        Tuna de Jaén
      </span>
    </a>

    <ul class="hidden items-center gap-1 whitespace-nowrap text-sm uppercase tracking-wider lg:flex xl:tracking-widest">
      {
        links.map((link) => (
          <li>
            <a
              href={link.href}
              aria-current={isCurrent(link.href) ? "page" : undefined}
              class="rounded-full px-3 py-2 transition-colors hover:bg-white/10 aria-[current=page]:bg-white/15 xl:px-4"
            >
              {link.label}
            </a>
          </li>
        ))
      }
      <li class="ml-2">
        <a
          href="/#contacto"
          class="rounded-full bg-primary-600 px-5 py-2.5 font-semibold transition hover:bg-primary-500"
        >
          Contrátanos
        </a>
      </li>
    </ul>

    <button
      id="menu-button"
      type="button"
      class="flex h-11 w-11 flex-col items-center justify-center gap-1.5 rounded-full bg-black/40 backdrop-blur lg:hidden"
      aria-expanded="false"
      aria-controls="mobile-menu"
      aria-label="Abrir menú de navegación"
    >
      <span class="h-0.5 w-5 bg-white transition duration-300"></span>
      <span class="h-0.5 w-5 bg-white transition duration-300"></span>
      <span class="h-0.5 w-5 bg-white transition duration-300"></span>
    </button>
  </nav>

  <div
    id="mobile-menu"
    class="pointer-events-none fixed inset-0 -z-10 flex flex-col items-center justify-center gap-6 bg-ink/95 text-2xl uppercase tracking-widest text-white opacity-0 transition-opacity duration-300 lg:hidden"
  >
    {links.map((link) => <a href={link.href}>{link.label}</a>)}
    <a
      href="/#contacto"
      class="mt-4 rounded-full bg-primary-600 px-8 py-3 text-lg font-semibold"
    >
      Contrátanos
    </a>
  </div>
</header>

<style>
  #site-header.scrolled {
    background-color: rgb(35 31 32 / 0.9);
    backdrop-filter: blur(8px);
  }
  #site-header.open #mobile-menu {
    opacity: 1;
    pointer-events: auto;
  }
  #site-header.open #menu-button span:nth-child(1) {
    transform: translateY(8px) rotate(45deg);
  }
  #site-header.open #menu-button span:nth-child(2) {
    opacity: 0;
  }
  #site-header.open #menu-button span:nth-child(3) {
    transform: translateY(-8px) rotate(-45deg);
  }
</style>

<script>
  import { $, $$ } from "@/lib/dom-selector";

  function setupNavbar() {
    const header = $("#site-header");
    const button = $("#menu-button");
    if (!header || !button) return;

    const setOpen = (open: boolean) => {
      header.classList.toggle("open", open);
      button.setAttribute("aria-expanded", String(open));
      button.setAttribute(
        "aria-label",
        open ? "Cerrar menú de navegación" : "Abrir menú de navegación"
      );
      document.body.classList.toggle("overflow-hidden", open);
    };

    button.addEventListener("click", () =>
      setOpen(!header.classList.contains("open"))
    );
    $$("#mobile-menu a").forEach((link) =>
      link.addEventListener("click", () => setOpen(false))
    );

    const onScroll = () =>
      header.classList.toggle("scrolled", window.scrollY > 40);
    window.addEventListener("scroll", onScroll, { passive: true });
    onScroll();
  }

  document.addEventListener("astro:page-load", setupNavbar);
</script>
