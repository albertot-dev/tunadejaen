---
import Encabezado from "@/components/Encabezado.astro";
import RichText from "@/components/RichText.astro";
import type { Bloque } from "@/lib/strapi";

type Props = Extract<Bloque, { __component: "bloques.texto" }>;

const { antetitulo, titulo, contenido, letraCapital } = Astro.props;
const conEncabezado = Boolean(antetitulo || titulo);
---

<section
  class:list={[
    "mx-auto max-w-7xl px-4 py-24 lg:px-8 lg:py-32",
    conEncabezado && "grid gap-12 lg:grid-cols-[1fr_1.4fr] lg:gap-24",
  ]}
>
  <Encabezado antetitulo={antetitulo} titulo={titulo} class="" reveal="left" />
  <div data-reveal={conEncabezado ? "right" : ""} class:list={[!conEncabezado && "mx-auto max-w-3xl"]}>
    <RichText contenido={contenido} class:list={["prosa", letraCapital && "prosa--capital"]} />
  </div>
</section>
