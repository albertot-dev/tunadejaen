---
import Encabezado from "@/components/Encabezado.astro";
import type { Bloque } from "@/lib/strapi";

type Props = Extract<Bloque, { __component: "bloques.tarjetas" }> & { id?: string };

const { id, antetitulo, titulo, numeradas, tarjetas } = Astro.props;

const columnas =
  tarjetas.length <= 2 ? "md:grid-cols-2" : tarjetas.length === 3 ? "md:grid-cols-3" : "sm:grid-cols-2 lg:grid-cols-4";
const grandes = tarjetas.length <= 2;
---

<section id={id} class="mx-auto max-w-7xl px-4 py-24 lg:px-8 lg:py-32">
  <Encabezado antetitulo={antetitulo} titulo={titulo} />
  <ul class:list={["grid gap-6", columnas, (antetitulo || titulo) && "mt-14"]}>
    {
      tarjetas.map((tarjeta, index) => (
        <li
          class:list={[
            "group flex flex-col rounded-3xl border border-ink/10 bg-white transition duration-300 hover:-translate-y-1 hover:border-primary-600 hover:shadow-xl",
            grandes ? "p-8 lg:p-12" : "p-7",
          ]}
          data-reveal
          style={`--delay: ${index * 120}ms`}
        >
          {numeradas ? (
            <span class="font-display text-5xl font-bold text-primary-600/30 transition group-hover:text-primary-600">
              {String(index + 1).padStart(2, "0")}
            </span>
          ) : (
            tarjeta.antetitulo && (
              <span class="text-sm font-semibold uppercase tracking-[0.25em] text-primary-700">
                {tarjeta.antetitulo}
              </span>
            )
          )}
          <h3 class:list={["font-display font-bold", grandes ? "mt-3 text-3xl" : "mt-6 text-2xl"]}>{tarjeta.titulo}</h3>
          {tarjeta.texto && (
            <p class:list={["leading-relaxed text-ink/75", grandes ? "mt-4 text-lg" : "mt-3"]}>{tarjeta.texto}</p>
          )}
        </li>
      ))
    }
  </ul>
</section>
