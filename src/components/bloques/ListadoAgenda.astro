---
import EmptyState from "@/components/EmptyState.astro";
import { getActuaciones } from "@/lib/strapi";

const today = new Date().toISOString().slice(0, 10);
const proximos = (await getActuaciones()).filter((evento) => evento.fecha >= today);

const formatDay = (fecha: string) => {
  const date = new Date(`${fecha}T12:00:00`);
  return {
    day: date.toLocaleDateString("es-ES", { day: "2-digit" }),
    month: date.toLocaleDateString("es-ES", { month: "short" }).replace(".", ""),
    weekday: date.toLocaleDateString("es-ES", { weekday: "long" }),
  };
};
---

<section class="mx-auto max-w-5xl px-4 py-24 lg:px-8 lg:py-32">
  {
    proximos.length === 0 ? (
      <EmptyState
        title="Afinando la próxima ronda"
        text="Ahora mismo no tenemos actuaciones públicas anunciadas. ¡Vuelve pronto o síguenos de cerca!"
      />
    ) : (
      <ol class="divide-y divide-ink/10 overflow-hidden rounded-3xl bg-white shadow-sm">
        {proximos.map((evento, index) => {
          const { day, month, weekday } = formatDay(evento.fecha);
          return (
            <li class="flex flex-col gap-6 p-6 sm:flex-row sm:items-center sm:p-8" data-reveal style={`--delay: ${index * 100}ms`}>
              <div class="flex h-24 w-24 shrink-0 flex-col items-center justify-center rounded-2xl bg-primary-600 text-white">
                <span class="font-display text-4xl font-bold leading-none">{day}</span>
                <span class="mt-1 text-sm uppercase tracking-widest">{month}</span>
              </div>
              <div class="grow">
                <p class="text-sm uppercase tracking-widest text-primary-700">
                  {weekday}
                  {evento.hora && ` · ${evento.hora.slice(0, 5)} h`}
                </p>
                <h2 class="mt-1 font-display text-2xl font-bold">{evento.titulo}</h2>
                <p class="mt-1 text-ink/70">{evento.lugar}</p>
                {evento.descripcion && <p class="mt-2 text-ink/70">{evento.descripcion}</p>}
              </div>
              {evento.enlace && (
                <a
                  href={evento.enlace}
                  target="_blank"
                  rel="noopener"
                  class="shrink-0 rounded-full border border-ink/20 px-5 py-2.5 font-semibold transition hover:border-primary-600 hover:text-primary-700"
                >
                  Más info
                </a>
              )}
            </li>
          );
        })}
      </ol>
    )
  }
</section>
