---
import EmptyState from "@/components/EmptyState.astro";
import { getContacto, getNoticias } from "@/lib/strapi";

const noticias = await getNoticias();
const contacto = await getContacto();

const formatDate = (fecha: string) =>
  new Date(`${fecha}T12:00:00`).toLocaleDateString("es-ES", {
    day: "numeric",
    month: "long",
    year: "numeric",
  });
---

<section class="mx-auto max-w-5xl px-4 py-24 lg:px-8 lg:py-32">
  {
    noticias.length === 0 ? (
      <EmptyState
        title="Sala de prensa"
        text="Estamos recopilando las noticias y reportajes publicados sobre la Tuna. Si eres periodista y quieres hablar con nosotros, escríbenos."
      >
        {contacto && (
          <a
            href={`mailto:${contacto.email}`}
            class="rounded-full bg-primary-600 px-6 py-3 font-semibold text-white transition hover:bg-primary-500"
          >
            {contacto.email}
          </a>
        )}
      </EmptyState>
    ) : (
      <ul class="grid gap-6 md:grid-cols-2">
        {noticias.map((noticia, index) => (
          <li data-reveal style={`--delay: ${(index % 2) * 120}ms`}>
            <a
              href={noticia.url}
              target="_blank"
              rel="noopener"
              class="group flex h-full flex-col rounded-3xl border border-ink/10 bg-white p-8 transition-colors duration-300 hover:border-primary-600"
            >
              <span class="text-sm uppercase tracking-widest text-primary-700">{noticia.medio}</span>
              <h2 class="mt-3 grow font-display text-2xl font-bold leading-snug">{noticia.titulo}</h2>
              <span class="mt-6 flex items-center justify-between text-sm text-ink/60">
                {formatDate(noticia.fecha)}
                <span class="font-semibold text-primary-700 transition group-hover:translate-x-1" aria-hidden="true">
                  Leer →
                </span>
              </span>
            </a>
          </li>
        ))}
      </ul>
    )
  }
</section>
