---
// Pantalla de bienvenida: escudo + lema y un telón que se abre sobre la portada.
// Solo se muestra la primera vez por sesión (ver Layout.astro).
---

<div id="intro" aria-hidden="true">
  <div class="intro-curtain intro-curtain--green"></div>
  <div class="intro-curtain intro-curtain--ink">
    <div class="flex flex-col items-center gap-6 px-4 text-center text-white">
      <img src="/escudo-tuna-blanco.png" alt="" class="intro-escudo h-32 w-32 sm:h-40 sm:w-40" />
      <p class="intro-lema font-display text-xl italic sm:text-2xl">
        la muy ilustre e andariega
      </p>
      <span class="intro-line block h-px w-48 bg-primary-400"></span>
    </div>
  </div>
</div>

<script is:inline>
  // Con la web bloqueada no se ve la intro, así que no se da por vista
  if (!document.documentElement.classList.contains("en-construccion")) {
    try {
      sessionStorage.setItem("intro-visto", "1");
    } catch {}
  }
</script>

<style>
  #intro {
    position: fixed;
    inset: 0;
    z-index: 100;
    pointer-events: none;
  }
  :global(.intro-skip) #intro {
    display: none;
  }
  .intro-curtain {
    position: absolute;
    inset: 0;
    animation: curtain-up 1s cubic-bezier(0.76, 0, 0.24, 1) forwards;
  }
  .intro-curtain--ink {
    display: flex;
    align-items: center;
    justify-content: center;
    background: #231f20;
    animation-delay: 2s;
  }
  .intro-curtain--green {
    background: #008e5c;
    animation-delay: 2.15s;
  }
  .intro-escudo {
    animation: escudo-in 1.1s cubic-bezier(0.16, 1, 0.3, 1) both;
  }
  .intro-lema {
    animation: fade-up 0.9s cubic-bezier(0.16, 1, 0.3, 1) 0.6s both;
  }
  .intro-line {
    transform-origin: center;
    animation: line-grow 1s cubic-bezier(0.76, 0, 0.24, 1) 0.9s both;
  }

  @keyframes curtain-up {
    to {
      transform: translateY(-100%);
    }
  }
  @keyframes escudo-in {
    from {
      opacity: 0;
      transform: scale(0.6) rotate(-20deg);
      filter: blur(8px);
    }
  }
  @keyframes fade-up {
    from {
      opacity: 0;
      transform: translateY(16px);
      letter-spacing: 0.3em;
    }
  }
  @keyframes line-grow {
    from {
      transform: scaleX(0);
    }
  }
</style>
