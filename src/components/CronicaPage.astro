---
import { Image, getImage } from "astro:assets";
import { render } from "astro:content";
import Lightbox from "@/components/Lightbox.astro";
import PageHero from "@/components/PageHero.astro";
import type { EventoAnual } from "@/data/eventos";
import { getFotos, getPortada, getYear, type Cronica } from "@/lib/cronicas";
import Layout from "@/layouts/Layout.astro";

interface Props {
  evento: EventoAnual;
  cronica: Cronica;
  /** Todas las ediciones del evento, de la más reciente a la más antigua */
  cronicas: Cronica[];
}

const { evento, cronica, cronicas } = Astro.props;
const year = getYear(cronica);
const { Content } = await render(cronica);

const portada = getPortada(cronica);
const fotos = await Promise.all(
  getFotos(cronica).map(async (foto) => ({
    ...foto,
    large: (await getImage({ src: foto.src, width: 1800 })).src,
  }))
);

const index = cronicas.findIndex((item) => item.id === cronica.id);
const posterior = cronicas[index - 1];
const anterior = cronicas[index + 1];

const fecha = cronica.data.fecha.toLocaleDateString("es-ES", {
  weekday: "long",
  day: "numeric",
  month: "long",
  year: "numeric",
});
const canonical = new URL(`/${evento.slug}/${year}`, Astro.site ?? Astro.url).href;
---

<Layout title={`${evento.nombre} ${year} · Tuna de Jaén`} description={cronica.data.resumen}>
  <link slot="head" rel="canonical" href={canonical} />

  <PageHero
    eyebrow={`${evento.nombre} · ${year}`}
    title={cronica.data.titulo}
    subtitle={cronica.data.resumen}
    image={portada?.src}
    imageAlt={portada ? `${evento.nombre} ${year}` : ""}
  />

  <nav class="sticky top-20 z-30 border-b border-ink/10 bg-cream/90 backdrop-blur" aria-label="Ediciones">
    <div class="mx-auto flex max-w-7xl items-center gap-2 overflow-x-auto px-4 py-3 lg:px-8">
      <span class="mr-2 shrink-0 text-sm font-semibold uppercase tracking-widest text-ink/60">Ediciones</span>
      {
        cronicas.map((item) => {
          const itemYear = getYear(item);
          return (
            <a
              href={`/${evento.slug}/${itemYear}`}
              aria-current={item.id === cronica.id ? "page" : undefined}
              class="shrink-0 rounded-full border border-ink/15 px-4 py-1.5 font-semibold tabular-nums transition hover:border-primary-600 hover:text-primary-700 aria-[current=page]:border-primary-600 aria-[current=page]:bg-primary-600 aria-[current=page]:text-white"
            >
              {itemYear}
            </a>
          );
        })
      }
    </div>
  </nav>

  <main>
    <article class="mx-auto max-w-3xl px-4 py-20 lg:py-28">
      <p class="text-sm font-semibold uppercase tracking-[0.25em] text-primary-700 first-letter:uppercase" data-reveal>
        {fecha}
      </p>
      <div class="cronica mt-8" data-reveal>
        <Content />
      </div>
    </article>

    <section class="bg-ink text-white">
      <div class="mx-auto max-w-7xl px-4 py-20 lg:px-8 lg:py-28">
        <div class="flex flex-wrap items-end justify-between gap-4" data-reveal>
          <div>
            <span class="text-sm font-semibold uppercase tracking-[0.25em] text-primary-400">Galería</span>
            <h2 class="mt-3 font-display text-4xl font-bold lg:text-5xl">
              {evento.nombre} {year} en fotos
            </h2>
          </div>
          {fotos.length > 0 && <p class="text-white/60">{fotos.length} fotos</p>}
        </div>

        {
          fotos.length > 0 ? (
            <ul class="mt-12 columns-2 gap-4 lg:columns-3">
              {fotos.map((foto, fotoIndex) => (
                <li class="mb-4 break-inside-avoid" data-reveal style={`--delay: ${(fotoIndex % 3) * 100}ms`}>
                  <button
                    type="button"
                    class="group relative block w-full overflow-hidden rounded-xl"
                    data-lightbox={foto.large}
                    data-caption={foto.caption ?? `${evento.nombre} ${year}`}
                    aria-label={`Ampliar foto ${fotoIndex + 1}`}
                  >
                    <Image
                      src={foto.src}
                      alt={foto.caption ?? `${evento.nombre} ${year}, foto ${fotoIndex + 1}`}
                      class="h-auto w-full transition duration-700 group-hover:scale-105"
                      widths={[400, 800]}
                      sizes="(min-width: 1024px) 26rem, 46vw"
                    />
                  </button>
                </li>
              ))}
            </ul>
          ) : (
            <p class="mt-10 text-lg text-white/60" data-reveal>
              Pronto subiremos las fotos de esta edición.
            </p>
          )
        }
      </div>
    </section>

    <nav class="mx-auto grid max-w-7xl gap-4 px-4 pt-20 sm:grid-cols-2 lg:px-8" aria-label="Otras ediciones">
      {
        anterior ? (
          <a
            href={`/${evento.slug}/${getYear(anterior)}`}
            class="group rounded-3xl border border-ink/10 bg-white p-8 transition hover:border-primary-600"
            data-reveal="left"
          >
            <span class="text-sm uppercase tracking-widest text-ink/60">← Edición anterior</span>
            <span class="mt-2 block font-display text-3xl font-bold group-hover:text-primary-700">
              {evento.nombre} {getYear(anterior)}
            </span>
          </a>
        ) : (
          <div />
        )
      }
      {
        posterior && (
          <a
            href={`/${evento.slug}/${getYear(posterior)}`}
            class="group rounded-3xl border border-ink/10 bg-white p-8 text-right transition hover:border-primary-600"
            data-reveal="right"
          >
            <span class="text-sm uppercase tracking-widest text-ink/60">Edición siguiente →</span>
            <span class="mt-2 block font-display text-3xl font-bold group-hover:text-primary-700">
              {evento.nombre} {getYear(posterior)}
            </span>
          </a>
        )
      }
    </nav>
  </main>

  <Lightbox />
</Layout>

<style>
  .cronica :global(p) {
    margin-top: 1.25em;
    font-size: 1.15rem;
    line-height: 1.8;
    color: rgb(35 31 32 / 0.85);
  }
  .cronica :global(p:first-child) {
    margin-top: 0;
  }
  .cronica > :global(p:first-child::first-letter) {
    float: left;
    margin-right: 0.75rem;
    font-family: "Fraunces Variable", serif;
    font-size: 4.5rem;
    font-weight: 700;
    line-height: 0.8;
    color: #007c54;
  }
  .cronica :global(h2),
  .cronica :global(h3) {
    margin-top: 2em;
    font-family: "Fraunces Variable", serif;
    font-weight: 700;
    line-height: 1.2;
  }
  .cronica :global(h2) {
    font-size: 2rem;
  }
  .cronica :global(h3) {
    font-size: 1.5rem;
  }
  .cronica :global(blockquote) {
    margin: 2em 0;
    border-left: 4px solid #008e5c;
    padding-left: 1.5rem;
    font-family: "Fraunces Variable", serif;
    font-size: 1.6rem;
    font-style: italic;
    line-height: 1.4;
  }
  .cronica :global(blockquote p) {
    font-size: inherit;
    color: inherit;
  }
  .cronica :global(a) {
    color: #007c54;
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 4px;
  }
  .cronica :global(ul),
  .cronica :global(ol) {
    margin-top: 1.25em;
    padding-left: 1.5rem;
    font-size: 1.15rem;
    line-height: 1.8;
  }
  .cronica :global(ul) {
    list-style: disc;
  }
  .cronica :global(ol) {
    list-style: decimal;
  }
</style>
