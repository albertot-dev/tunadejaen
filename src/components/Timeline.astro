---
import { getHitos } from "@/lib/strapi";

interface Props {
  showLink?: boolean;
}

const { showLink = true } = Astro.props;
const hitos = await getHitos();
---

<section id="historia" class="relative overflow-hidden bg-ink text-white">
  <div class="mx-auto max-w-7xl px-4 py-24 lg:px-8 lg:py-32">
    <div class="max-w-3xl" data-reveal>
      <span
        class="text-sm font-semibold uppercase tracking-[0.25em] text-primary-400"
        >Nuestra historia</span
      >
      <h2
        class="mt-3 text-balance font-display text-4xl font-bold leading-tight lg:text-6xl"
      >
        Más de sesenta años de tradición tunantesca en Jaén
      </h2>
    </div>

    <div class="relative mt-20" data-timeline style="--progress: 0">
      <!-- Línea base y línea que se rellena con el scroll -->
      <div
        class="absolute bottom-0 left-4 top-0 w-px bg-white/15 lg:left-1/2 lg:-translate-x-1/2"
        aria-hidden="true"
      >
        <div
          class="h-full w-full origin-top bg-gradient-to-b from-primary-400 to-primary-600 shadow-[0_0_12px_rgba(47,216,147,0.8)]"
          style="transform: scaleY(var(--progress))"
        >
        </div>
      </div>

      <ol>
        {
          hitos.slice(showLink ? -4 : 0).map((hito, index) => {
            const isRight = index % 2 === 1;
            return (
              <li class="relative grid pb-16 pl-14 last:pb-0 lg:grid-cols-2 lg:gap-24 lg:pl-0">
                <span
                  class="absolute left-4 top-3 z-10 h-4 w-4 -translate-x-1/2 rounded-full border-2 border-primary-400 bg-ink lg:left-1/2"
                  aria-hidden="true"
                />
                <div
                  class:list={[isRight ? "lg:col-start-2" : "lg:text-right"]}
                  data-reveal={isRight ? "right" : "left"}
                >
                  <p class="text-outline font-display text-6xl font-bold leading-none text-primary-400 lg:text-8xl">
                    {hito.anio}
                  </p>
                  <h3 class="mt-4 font-display text-2xl font-bold lg:text-3xl">
                    {hito.titulo}
                  </h3>
                  {hito.texto && (
                    <p
                      class:list={[
                        "mt-3 max-w-md text-lg leading-relaxed text-white/70",
                        !isRight && "lg:ml-auto",
                      ]}
                    >
                      {hito.texto}
                    </p>
                  )}
                </div>
              </li>
            );
          })
        }
      </ol>
    </div>

    {
      showLink && (
        <div class="mt-16 text-center" data-reveal>
          <a
            href="/historia"
            class="inline-flex items-center gap-2 rounded-full border border-white/30 px-7 py-3.5 font-semibold transition hover:border-primary-400 hover:bg-primary-400 hover:text-ink"
          >
            Lee la historia completa <span aria-hidden="true">→</span>
          </a>
        </div>
      )
    }
  </div>
</section>
